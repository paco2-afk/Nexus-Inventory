NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-this-with-a-long-random-string
MONGODB_URI=mongodb://127.0.0.1:27017/nexusdb
# Use an in-memory database if Mongo is not installed:
# MONGODB_URI=memory
SKIP_PIN_VERIFICATION=false
